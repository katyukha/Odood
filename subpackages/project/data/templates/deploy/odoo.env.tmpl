# Environment variables for Odoo, one NAME=value per line.
#
# Loaded by the Odoo system service, and by odood whenever it runs Odoo
# itself (updates, database operations, tests). Restart Odoo after a change.
# A variable already set in odood's own environment wins over this file.
#
# A value with characters other than letters, digits and _ . / : , @ % + = -
# goes in single quotes: NAME='some value'. No double quotes, $ or \.
{% if !config.odoo.system_ca_bundle_path.isNull %}
REQUESTS_CA_BUNDLE={{ config.odoo.system_ca_bundle_path.get }}
{% endif %}
